# Local dev defaults. Copy this file to `.env` (gitignored) and adjust as needed.
# Loaded by `expo start` unless `.env.local` / `.env.development` override it.
#
# For physical device testing (Expo Go on your phone), create `.env.local`
# (also gitignored) with your Mac's LAN IP instead of localhost:
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
#
# Real `.env*` files are git-ignored — only the `*.example` templates are committed.
EXPO_PUBLIC_API_URL=http://localhost:8000
