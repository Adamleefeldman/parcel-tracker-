{
  "expo": {
    "name": "FMCG Hub",
    "slug": "fmcg-hub",
    "scheme": "fmcghub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thefmcghub.logistics"
    },
    "android": {
      "package": "com.thefmcghub.logistics",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "FMCG Hub accesses your photos so you can attach documents to a booking.",
          "cameraPermission": "FMCG Hub uses the camera so you can photograph documents to attach to a booking."
        }
      ]
    ]
  }
}
