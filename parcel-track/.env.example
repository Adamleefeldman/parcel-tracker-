# ParcelTrack backend environment variables.
# Copy to .env and fill in real values. NEVER commit the .env file.
#
#     cp .env.example .env
#
# docker-compose.yml hardcodes local Postgres/Redis credentials so you
# only need to fill in storage + push settings if you want those features
# working locally.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=ParcelTrack

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be >= 32 characters. Placeholder values are rejected at boot.
SECRET_KEY=CHANGEME_GENERATE_A_REAL_SECRET_KEY_WITH_SECRETS_TOKEN_HEX

# ── Database ──────────────────────────────────────────────────────────────────
# docker-compose.yml sets these automatically. Only override if connecting
# to an external database (e.g. Supabase).
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parceltrack
# DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/parceltrack

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
INVITE_TOKEN_EXPIRE_HOURS=72

# ── File storage (Cloudflare R2 / S3-compatible) ─────────────────────────────
STORAGE_BUCKET=parceltrack-documents
STORAGE_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your-r2-access-key
STORAGE_SECRET_ACCESS_KEY=your-r2-secret-key
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=https://files.yourdomain.com

# ── Redis (Celery broker + result backend) ────────────────────────────────────
# docker-compose.yml sets this automatically for local dev.
# REDIS_URL=redis://localhost:6379/0

# ── Push notifications ────────────────────────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Outbound integrations (shared HTTP helper) ────────────────────────────────
# Total request timeout in seconds. Applies to every call made via
# app.integrations._http (Expo push, future Destin8 / VesselFinder pollers).
INTEGRATION_HTTP_TIMEOUT_SECONDS=10.0
# Retries beyond the first attempt. Total tries = this + 1.
# Backoff is jittered exponential. Only transient failures (timeouts, 5xx,
# network errors) are retried — 429 / 4xx are not.
INTEGRATION_HTTP_RETRIES=2
# Circuit breaker: trip open after this many consecutive transient failures
# against one provider; block further calls for the cooldown period.
INTEGRATION_CIRCUIT_BREAKER_THRESHOLD=5
INTEGRATION_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ── VesselFinder poller (P1.5) ────────────────────────────────────────────────
# Fleet-subscription model: one /vesselslist call returns all tracked vessels.
# Find the Fleet key on your VesselFinder account page (labelled "Fleet key";
# it maps to the docs' `userkey` parameter). Treat it as a secret — never
# commit it. Rotate quarterly (or sooner if the key was ever exposed).
#
# Leave VESSELFINDER_ENABLED=false until smoke_vesselfinder.py round-trips
# against the real key; the beat task no-ops while disabled.
VESSELFINDER_ENABLED=false
VESSELFINDER_BASE_URL=https://api.vesselfinder.com
VESSELFINDER_FLEET_KEY=your-fleet-key-here
# Poll cadence — drives the beat schedule. 30 min is a reasonable default for
# a satellite-class subscription; raise it if the fleet is small and budget
# is tight.
VESSELFINDER_POLL_INTERVAL_MINUTES=30
# Only persist an ETA change if it differs from the stored ETA by at least
# this many hours. Filters out AIS jitter without missing real schedule slips.
VESSELFINDER_ETA_CHANGE_THRESHOLD_HOURS=2
# Mark a vessel DELAYED when the revised ETA exceeds the originally stored
# ETA by more than this many hours.
VESSELFINDER_DELAYED_THRESHOLD_HOURS=24
# Mark a vessel APPROACHING when its position is within this many nautical
# miles of the port_of_discharge centroid (UNLOCODE lookup table is in
# app/services/vessel_poll_service.py).
VESSELFINDER_APPROACHING_RADIUS_NM=50

# ── Login lockout ────────────────────────────────────────────────────────────
# Lock an account after this many consecutive failures within the window.
# LOGIN_MAX_ATTEMPTS=5
# Window duration in seconds (default: 900 = 15 minutes).
# LOGIN_LOCKOUT_WINDOW_SECONDS=900

# ── Sentry ────────────────────────────────────────────────────────────────────
# Leave empty to disable. Set to your project DSN to enable error tracking.
# Get your DSN at: https://sentry.io → Project Settings → Client Keys
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Fraction of transactions to trace (0.0–1.0). Set lower in high-traffic prod.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Defaults to APP_ENV if empty.
# SENTRY_ENVIRONMENT=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Empty in dev falls back to wildcard.
# Empty in production is a hard boot-time error.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Comma-separated trusted proxy IPs/CIDRs. Only set in production behind a
# reverse proxy. X-Forwarded-For is only honoured when this is set.
# TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,108.162.192.0/18
