# ── Application ──────────────────────────────────────────
APP_ENV=development                  # development | staging | production
APP_NAME=ParcelTrack
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database (Supabase Postgres) ──────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/parceltrack
DATABASE_URL_SYNC=postgresql://user:password@host:5432/parceltrack  # for Alembic migrations

# ── Auth ──────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
INVITE_TOKEN_EXPIRE_HOURS=72

# ── File Storage (Cloudflare R2 or AWS S3) ────────────────
STORAGE_BUCKET=parceltrack-documents
STORAGE_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your-key
STORAGE_SECRET_ACCESS_KEY=your-secret
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=https://files.yourdomain.com

# ── Redis (for Celery background jobs) ───────────────────
REDIS_URL=redis://localhost:6379/0

# ── Push Notifications (Expo) ────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Railway / Supabase ───────────────────────────────────
# Set DATABASE_URL above to the Railway or Supabase connection string
