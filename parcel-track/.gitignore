# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/

# Environment variables (.env and any per-environment overrides like .env.test)
.env
.env.*

# Working-task scratchpad — CLAUDE.md ("Commit Rules") forbids committing
# planning artifacts. The directory exists locally; nothing in it is tracked.
tasks/

# File-backed Docker secrets — never commit values. Only the dir scaffolding
# (.gitkeep + README) is tracked; everything else is ignored.
/secrets/*
!/secrets/.gitkeep
!/secrets/README.md

# Test / coverage artefacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Mypy / ruff caches
.mypy_cache/
.ruff_cache/

# IDE
.idea/
.vscode/
